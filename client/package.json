    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "^1.3.4",
    "@vitejs/plugin-vue": "6.0.10",
    "bmo-ui": "file:vendor/bmo-ui-1.1.0-0.nightly.20261127.tgz",
    "nuxt": "^4.5.2",
    "ofetch": "^1.4.1",
    "playwright-core": "1.62.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "21.1.0",
    "unplugin-vue-components": "32.1.0",
    "vite": "8.3.4",
